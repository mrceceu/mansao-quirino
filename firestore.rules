rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /casas/quirino/despesas/{id} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null
        && request.resource.data.keys().hasAll(['id', 'total', 'autor', 'thumb'])
        && request.resource.data.thumb is string
        && request.resource.data.thumb.size() < 60000;
      allow delete: if request.auth != null && resource.data.autorUid == request.auth.uid;
    }
    match /casas/quirino/fotos/{id} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null
        && request.resource.data.data is string
        && request.resource.data.data.size() < 900000
        && request.resource.data.autorUid == request.auth.uid;
      allow delete: if request.auth != null && resource.data.autorUid == request.auth.uid;
    }
    match /casas/quirino/acertos/{id} {
      allow read, create, delete: if request.auth != null;
    }
    match /casas/quirino/membros/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
