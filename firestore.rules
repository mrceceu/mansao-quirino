// Regras do Firestore da Mansão Quirino.
// CODIGO_DA_CASA é substituído pelo código real só no console do Firebase.
// O código fica fora do repositório e é compartilhado apenas pelo link.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /casas/CODIGO_DA_CASA/despesas/{id} {
      allow read, delete: if request.auth != null;
      allow create, update: if request.auth != null
        && request.resource.data.keys().hasAll(['id', 'total', 'autor', 'thumb'])
        && request.resource.data.thumb is string
        && request.resource.data.thumb.size() < 60000;
    }
    match /casas/CODIGO_DA_CASA/fotos/{id} {
      allow read, delete: if request.auth != null;
      allow create, update: if request.auth != null
        && request.resource.data.data is string
        && request.resource.data.data.size() < 900000;
    }
    match /casas/CODIGO_DA_CASA/acertos/{id} {
      allow read, create, delete: if request.auth != null;
    }
    match /casas/CODIGO_DA_CASA/membros/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
